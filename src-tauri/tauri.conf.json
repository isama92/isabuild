{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "isabuild",
  "version": "0.1.0",
  "identifier": "com.isabuild.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "isabuild",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "isabuild",
    "copyright": "Copyright © 2026 isabuild contributors",
    "shortDescription": "Claude Code in a terminal, wrapped with live git tooling",
    "longDescription": "A cross-platform desktop app that embeds Claude Code in a terminal and wraps it with live git tooling: a real-time changed-files panel, a diff viewer, branch and remote operations, and a graphical three-pane merge conflict resolver.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["git"]
      },
      "rpm": {
        "depends": ["git"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
